# Shared runtime defaults for the active SDN toolchain.
#
# This file is sourced by Bash. Every value can be overridden by exporting the
# same variable before running a setup/deploy command, or by pointing
# SDN_RUNTIME_CONFIG at another compatible file.

RYU_IMG="${RYU_IMG:-ryu_core_cnsm}"
SSW_IMG="${SSW_IMG:-simpleswitch_cnsm}"
FB_IMG="${FB_IMG:-flow_blocker_cnsm}"
PRED_IMG="${PRED_IMG:-flow_predictor_cnsm}"
ETCD_IMG="${ETCD_IMG:-bitnami/etcd}"

SUBNET_BASE="${SUBNET_BASE:-10}"
CTRL_OF_PORT_BASE="${CTRL_OF_PORT_BASE:-6633}"
CTRL_API_PORT_BASE="${CTRL_API_PORT_BASE:-8080}"
SSW_HTTP_PORT_BASE="${SSW_HTTP_PORT_BASE:-9090}"
FB_HTTP_PORT_BASE="${FB_HTTP_PORT_BASE:-7070}"
PREDICTOR_PORT_BASE="${PREDICTOR_PORT_BASE:-6060}"

ETCD_SUBNET="${ETCD_SUBNET:-253}"
ETCD_NODES="${ETCD_NODES:-3}"
ETCD_NET="${ETCD_NET:-etcd-network}"
ETCD_PREFIX="${ETCD_PREFIX:-192.168.${ETCD_SUBNET}}"
RYU_NETWORK_PREFIX="${RYU_NETWORK_PREFIX:-ryu-network}"

_default_initial_cluster=""
_default_etcd_endpoints=""
for ((_etcd_i = 1; _etcd_i <= ETCD_NODES; _etcd_i++)); do
  _etcd_sep="${_default_initial_cluster:+,}"
  _etcd_ip="${ETCD_PREFIX}.$((_etcd_i + 10))"
  _default_initial_cluster+="${_etcd_sep}etcd${_etcd_i}=http://${_etcd_ip}:2380"
  _default_etcd_endpoints+="${_etcd_sep}${_etcd_ip}:2379"
done
INITIAL_CLUSTER="${INITIAL_CLUSTER:-$_default_initial_cluster}"
ETCD_ENDPOINTS="${ETCD_ENDPOINTS:-$_default_etcd_endpoints}"
unset _default_initial_cluster _default_etcd_endpoints _etcd_i _etcd_sep _etcd_ip

PREDICTOR_EXPORT_ENABLED="${PREDICTOR_EXPORT_ENABLED:-true}"
PREDICTOR_EXPORT_PREFIXES="${PREDICTOR_EXPORT_PREFIXES:-flow:}"
PREDICTOR_EXPORT_FLUSH_EVERY="${PREDICTOR_EXPORT_FLUSH_EVERY:-10}"
PREDICTOR_POLL_INTERVAL_S="${PREDICTOR_POLL_INTERVAL_S:-2.0}"
PREDICTOR_Z_THRESHOLD="${PREDICTOR_Z_THRESHOLD:-4.0}"
PREDICTOR_WARMUP_SAMPLES="${PREDICTOR_WARMUP_SAMPLES:-15}"
PREDICTOR_FLOW_SURGE_WARMUP_SAMPLES="${PREDICTOR_FLOW_SURGE_WARMUP_SAMPLES:-15}"
PREDICTOR_MIN_RATE_BPS="${PREDICTOR_MIN_RATE_BPS:-50000}"
PREDICTOR_FLOW_IDLE_RESET_SAMPLES="${PREDICTOR_FLOW_IDLE_RESET_SAMPLES:-2}"
PREDICTOR_AUTO_MITIGATE="${PREDICTOR_AUTO_MITIGATE:-true}"
PREDICTOR_DRY_RUN="${PREDICTOR_DRY_RUN:-true}"
PREDICTOR_COOLDOWN_S="${PREDICTOR_COOLDOWN_S:-60}"
PREDICTOR_EVENT_COOLDOWN_S="${PREDICTOR_EVENT_COOLDOWN_S:-60}"
PREDICTOR_WHITELIST_IPS="${PREDICTOR_WHITELIST_IPS:-}"
PREDICTOR_OFFLINE_MODEL="${PREDICTOR_OFFLINE_MODEL:-}"
PREDICTOR_OFFLINE_MODEL_REQUIRED="${PREDICTOR_OFFLINE_MODEL_REQUIRED:-false}"
PREDICTOR_ONLINE_MODEL_ADAPTATION="${PREDICTOR_ONLINE_MODEL_ADAPTATION:-false}"

# Dataset de utilização de portas para o pipeline preditivo de SLA. Continua
# desabilitado até que cada porta observada possua capacidade direcional
# explícita em bits por segundo, por exemplo {"1:1":100000000}.
PREDICTOR_QOS_TELEMETRY_ENABLED="${PREDICTOR_QOS_TELEMETRY_ENABLED:-false}"
PREDICTOR_QOS_PORT_CAPACITIES_JSON="${PREDICTOR_QOS_PORT_CAPACITIES_JSON:-}"
if [[ -z "$PREDICTOR_QOS_PORT_CAPACITIES_JSON" ]]; then
  PREDICTOR_QOS_PORT_CAPACITIES_JSON='{}'
fi
PREDICTOR_QOS_DATASET_FLUSH_EVERY="${PREDICTOR_QOS_DATASET_FLUSH_EVERY:-10}"
PREDICTOR_QOS_MAX_GAP_FACTOR="${PREDICTOR_QOS_MAX_GAP_FACTOR:-2.5}"

# Fusão multicritério entre FlowPredictors. Permanece opt-in para preservar o
# comportamento local em instalações existentes. Se vazio, o número esperado
# de domínios é preenchido por deploy_flow_predictor.sh com o argumento C.
PREDICTOR_COLLABORATION_ENABLED="${PREDICTOR_COLLABORATION_ENABLED:-false}"
PREDICTOR_COLLAB_EXPECTED_DOMAINS="${PREDICTOR_COLLAB_EXPECTED_DOMAINS:-}"
PREDICTOR_COLLAB_MIN_DOMAINS="${PREDICTOR_COLLAB_MIN_DOMAINS:-2}"
PREDICTOR_COLLAB_WINDOW_S="${PREDICTOR_COLLAB_WINDOW_S:-4}"
PREDICTOR_COLLAB_EVIDENCE_TTL_S="${PREDICTOR_COLLAB_EVIDENCE_TTL_S:-12}"
PREDICTOR_COLLAB_CLAIM_TTL_S="${PREDICTOR_COLLAB_CLAIM_TTL_S:-60}"
PREDICTOR_COLLAB_EVALUATION_INTERVAL_S="${PREDICTOR_COLLAB_EVALUATION_INTERVAL_S:-0.5}"
PREDICTOR_COLLAB_PERSISTENCE_WINDOWS="${PREDICTOR_COLLAB_PERSISTENCE_WINDOWS:-3}"
PREDICTOR_COLLAB_SUSPECT_THRESHOLD="${PREDICTOR_COLLAB_SUSPECT_THRESHOLD:-0.40}"
PREDICTOR_COLLAB_ALERT_THRESHOLD="${PREDICTOR_COLLAB_ALERT_THRESHOLD:-0.60}"
PREDICTOR_COLLAB_DECISION_THRESHOLD="${PREDICTOR_COLLAB_DECISION_THRESHOLD:-0.80}"
PREDICTOR_COLLAB_RATE_RATIO_MAX="${PREDICTOR_COLLAB_RATE_RATIO_MAX:-10}"
PREDICTOR_COLLAB_WEIGHTS_JSON="${PREDICTOR_COLLAB_WEIGHTS_JSON:-}"

# Agente deliberativo por domínio. `shadow` apenas compara sua negociação com
# o MCDA. `authority-dry-run` revalida AGREED e elege um coordenador em um
# prefixo ETCD próprio, mas continua fisicamente desconectado do FlowBlocker.
# `authority-live` exige também o opt-in abaixo e transfere a propriedade da
# atuação ao agente vencedor; o MCDA permanece apenas como comparador.
PREDICTOR_AGENTIC_ENABLED="${PREDICTOR_AGENTIC_ENABLED:-false}"
PREDICTOR_AGENTIC_SHADOW="${PREDICTOR_AGENTIC_SHADOW:-true}"
PREDICTOR_AGENTIC_MODE="${PREDICTOR_AGENTIC_MODE:-shadow}"
PREDICTOR_AGENT_REQUIRED_VOTES="${PREDICTOR_AGENT_REQUIRED_VOTES:-2}"
PREDICTOR_AGENT_PROPOSAL_TTL_S="${PREDICTOR_AGENT_PROPOSAL_TTL_S:-12}"
PREDICTOR_AGENT_NEGOTIATION_WINDOW_S="${PREDICTOR_AGENT_NEGOTIATION_WINDOW_S:-4}"
PREDICTOR_AGENT_PROPOSAL_THRESHOLD="${PREDICTOR_AGENT_PROPOSAL_THRESHOLD:-0.65}"
PREDICTOR_AGENT_TOPOLOGY_CACHE_S="${PREDICTOR_AGENT_TOPOLOGY_CACHE_S:-5}"
PREDICTOR_AGENT_CLAIM_TTL_S="${PREDICTOR_AGENT_CLAIM_TTL_S:-60}"
PREDICTOR_AGENTIC_LIVE_ACTUATION="${PREDICTOR_AGENTIC_LIVE_ACTUATION:-false}"
